# Optional: override the default FormSubmit contact endpoint with your own form API.
# Example: VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
VITE_CONTACT_ENDPOINT=

# Sanity CMS (create a project at https://www.sanity.io/manage)
# Public read values — safe to expose in the Vite SPA
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Used by Sanity CLI / Studio when running `npm run sanity`
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
